<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Kawa.Core/Kawa.Core.csproj" />
    <ProjectReference Include="../../src/Kawa.Grpc/Kawa.Grpc.csproj" />
    <PackageReference Include="Grpc.Tools" Version="2.57.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Kawa.Grpc.Generators/Kawa.Grpc.Generators.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <KawaProtoPackageName>kawa.chat</KawaProtoPackageName>
    <KawaGrpcGeneratorsAssemblyPath>$(MSBuildProjectDirectory)/../../src/Kawa.Grpc.Generators/bin/$(Configuration)/net10.0/Kawa.Grpc.Generators.dll</KawaGrpcGeneratorsAssemblyPath>
  </PropertyGroup>
  <Import Project="../../src/Kawa.Grpc.Generators/buildTransitive/Kawa.Grpc.Generators.targets" />
</Project>
