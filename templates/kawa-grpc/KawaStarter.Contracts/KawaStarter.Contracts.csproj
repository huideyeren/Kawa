<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.57.0" PrivateAssets="all" />
    <PackageReference Include="Kawa.Core" Version="__KAWA_VERSION__" />
    <PackageReference Include="Kawa.Grpc" Version="__KAWA_VERSION__" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Kawa.Grpc.Generators" Version="__KAWA_VERSION__" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <KawaProtoPackageName>kawa.chat</KawaProtoPackageName>
  </PropertyGroup>
</Project>
