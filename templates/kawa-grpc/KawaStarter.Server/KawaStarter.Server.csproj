<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KawaStarter.Contracts/KawaStarter.Contracts.csproj" />
    <PackageReference Include="Grpc.Tools" Version="2.57.0" PrivateAssets="all" />
    <PackageReference Include="Kawa.Web" Version="__KAWA_VERSION__" />
    <PackageReference Include="Kawa.Grpc.ProtoAdapter" Version="__KAWA_VERSION__" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos/legacy.proto" GrpcServices="Server" />
  </ItemGroup>
</Project>
