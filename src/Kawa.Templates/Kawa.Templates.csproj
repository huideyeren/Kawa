<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeContentInPack>true</IncludeContentInPack>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <Description>CLI, MagicOnion, protobuf gRPC and Aspire project templates for Kawa.</Description>
  </PropertyGroup>
  <ItemGroup><Content Include="../../templates/**/*" Exclude="../../templates/**/bin/**;../../templates/**/obj/**" Pack="true" PackagePath="content/" /></ItemGroup>
</Project>
