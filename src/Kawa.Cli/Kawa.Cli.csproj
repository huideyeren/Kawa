<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>System.CommandLine adapter for Kawa use cases.</Description>
    <PackageTags>kawa;cli;commandline;usecase</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Kawa.Core/Kawa.Core.csproj" />
    <ProjectReference Include="../Kawa.Abstractions/Kawa.Abstractions.csproj" />
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>
</Project>
