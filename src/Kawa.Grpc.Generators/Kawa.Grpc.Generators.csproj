<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Build-time protobuf schema generation for Kawa use cases.</Description>
    <PackageTags>kawa;dotnet;grpc;protobuf;generator</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.8.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)Kawa.Grpc.Generators.dll" Pack="true" PackagePath="tools/net10.0/" />
    <None Include="$(OutputPath)Microsoft.CodeAnalysis.dll" Pack="true" PackagePath="tools/net10.0/" />
    <None Include="$(OutputPath)Microsoft.CodeAnalysis.CSharp.dll" Pack="true" PackagePath="tools/net10.0/" />
    <None Include="ThirdPartyNotices.Roslyn.rtf" Pack="true" PackagePath="tools/net10.0/" />
    <None Include="buildTransitive\Kawa.Grpc.Generators.targets" Pack="true" PackagePath="buildTransitive\Kawa.Grpc.Generators.targets" />
  </ItemGroup>

</Project>
