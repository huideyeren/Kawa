<Project>
  <PropertyGroup>
    <KawaGrpcGeneratorsAssemblyPath Condition="'$(KawaGrpcGeneratorsAssemblyPath)' == ''">$(MSBuildThisFileDirectory)..\lib\net10.0\Kawa.Grpc.Generators.dll</KawaGrpcGeneratorsAssemblyPath>
  </PropertyGroup>

  <UsingTask TaskName="Kawa.Grpc.Generators.KawaProtoSchemaGenerationTask"
             AssemblyFile="$(KawaGrpcGeneratorsAssemblyPath)" />

  <PropertyGroup>
    <KawaProtoPackageName Condition="'$(KawaProtoPackageName)' == ''">$(RootNamespace)</KawaProtoPackageName>
    <KawaProtoCSharpNamespace Condition="'$(KawaProtoCSharpNamespace)' == ''">$(RootNamespace).Proto</KawaProtoCSharpNamespace>
    <KawaProtoOutputPath Condition="'$(KawaProtoOutputPath)' == ''">$(IntermediateOutputPath)Kawa\kawa.generated.proto</KawaProtoOutputPath>
  </PropertyGroup>

  <Target Name="KawaGrpcGenerateProto"
          BeforeTargets="PrepareForBuild"
          Condition="'@(Compile)' != '' or '@(KawaProtoService)' != ''">
    <PropertyGroup>
      <!-- IntermediateOutputPath is finalized after transitive targets are imported. -->
      <KawaProtoOutputPath Condition="'$(KawaProtoOutputPath)' == '' or '$(KawaProtoOutputPath)' == 'Kawa\kawa.generated.proto'">$(IntermediateOutputPath)Kawa\kawa.generated.proto</KawaProtoOutputPath>
    </PropertyGroup>

    <KawaProtoSchemaGenerationTask PackageName="$(KawaProtoPackageName)"
                                   CSharpNamespace="$(KawaProtoCSharpNamespace)"
                                   OutputPath="$(KawaProtoOutputPath)"
                                   ServiceDefinitions="@(KawaProtoService)"
                                   SourceFiles="@(Compile)">
      <Output TaskParameter="GeneratedSchemaPath" PropertyName="_KawaProtoGeneratedSchemaPath" />
    </KawaProtoSchemaGenerationTask>

    <ItemGroup>
      <Protobuf Include="$(_KawaProtoGeneratedSchemaPath)" GrpcServices="Both" ProtoRoot="$(IntermediateOutputPath)Kawa" Condition="'$(_KawaProtoGeneratedSchemaPath)' != ''" />
    </ItemGroup>
  </Target>
</Project>
